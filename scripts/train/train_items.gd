## The trophy of each locomotive (boss deck id -> item): a legend that only a beaten boss gives
## (TrainRun.fight_won). Never in the rewards or the shop (TrainRun._roll_items).
const TROPHIES := {"lich": "lich_cloak", "ice_king": "ice_crown", "lemongrab": "lemongrab_clock", "marceline": "marceline_bass"}

## Sets of items named after a hero: the hero has `need` of the `items` and the set's mods add up
## like one more item (TrainRun.bonus, set_done). `name` is the hero's name in the genitive ("Набор Финна").
const SETS := {
	"finn": {"name": "Финна", "items": ["finn_sword", "finn_backpack", "finn_socks"], "need": 2,
		"text": "Первая атака в каждом ходу всегда крит.", "mods": {"first_crit": 1}},
	"jake": {"name": "Джейка", "items": ["jake_slippers", "jake_helmet", "jake_ball"], "need": 2,
		"text": "Существо, атакующее существо, получает +1 ATK.", "mods": {"vs_atk": 1}},
	"lich": {"name": "Лича", "items": ["lich_cloak", "lich_pumpkin"], "need": 2,
		"text": "Уклонение +10%. Шипы +1.", "mods": {"dodge": 10, "thorns": 1}},
	"bmo": {"name": "BMO", "items": ["bmo_console", "bmo_remote"], "need": 2,
		"text": "После применения возьми карту. Раз в ход.", "mods": {"floop_draw": 1}},
	"princess": {"name": "Принцессы", "items": ["princess_vial", "princess_gum"], "need": 2,
		"text": "+2 к максимуму HP за каждую выигранную схватку.", "mods": {"hp_per_win": 2}},
}


static func item(id: String) -> Dictionary:
	return ITEMS[id]


static func is_trophy(id: String) -> bool:
	return TROPHIES.values().has(id)


static func rarity(id: String) -> Dictionary:
	return RARITY[ITEMS[id]["rarity"]]


